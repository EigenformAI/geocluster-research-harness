+++ b/packages/cli/test/acp/event-observation-background.test.ts
@@ -0,0 +1,187 @@
+import { expect, test } from "bun:test"
+import type { AgentSideConnection } from "@agentclientprotocol/sdk"
+import { streamTurn, type ChildSessionUpdate, type TurnControl } from "../../src/acp/event"
+import { createSseFixture, durableEvent, ephemeralEvent, withTimeout } from "./sse-fixture"
+
+type SessionUpdateParams = Parameters<AgentSideConnection["sessionUpdate"]>[0]
+type Fixture = ReturnType<typeof createSseFixture>
+
+test("records a child-owner gap after parent return and continues siblings and nested descendants", async () => {
+  const completed = Promise.withResolvers<void>()
+  const updates: ChildSessionUpdate[] = []
+  const rootUpdates: SessionUpdateParams[] = []
+  const fixture = createSseFixture({
+    onPrompt({ id, send }) {
+      send(durableEvent("session.inbox.delivered", { sessionID: "ses_root", inboxID: id }))
+      send(created("ses_child", "ses_root"))
+      send(created("ses_sibling", "ses_root"))
+      send(durableEvent("session.execution.started", { sessionID: "ses_child" }))
+      send(durableEvent("session.execution.started", { sessionID: "ses_sibling" }))
+      send(durableEvent("session.execution.succeeded", { sessionID: "ses_root" }))
+    },
+    onSessionGet: () => new Response("private lookup error and credentials", { status: 500 }),
+  })
+  try {
+    expect((await run(fixture, rootUpdates, async (update) => {
+      updates.push(update)
+      if (update.type === "status" && update.status === "completed" && update.childSessionId === "ses_child")
+        completed.resolve()
+    })).stopReason).toBe("end_turn")
+    dispatch(fixture, "ses_child", "call_nested", "ses_unknown")
+    fixture.send(text("ses_unknown", "private foreign answer"))
+    fixture.send(created("ses_descendant", "ses_sibling"))
+    fixture.send(text("ses_descendant", "nested answer"))
+    fixture.send(durableEvent("session.execution.succeeded", { sessionID: "ses_descendant" }))
+    fixture.send(durableEvent("session.execution.succeeded", { sessionID: "ses_sibling" }))
+    fixture.send(durableEvent("session.execution.succeeded", { sessionID: "ses_child" }))
+    await withTimeout(completed.promise, "known child completion stopped after observation gap")
+    const gap = updates.find((update) => update.type === "update" && update.update.sessionUpdate === "session_info_update")
+    expect(gap).toEqual({
+      rootSessionId: "ses_root", childSessionId: "ses_child", parentSessionId: "ses_root", depth: 1,
+      type: "update", update: {
+        sessionUpdate: "session_info_update", _meta: {
+          "geocluster/child-observation": {
+            state: "incomplete", reason: "registration_failed", toolCallId: "ses_child:call_nested", childSessionId: "ses_unknown",
+          },
+          "opencode/child-session": { id: "ses_child", parentID: "ses_root", depth: 1 },
+        },
+      },
+    })
+    expect(updates.filter((update) => update.type === "status" && update.status === "completed").map((update) => update.childSessionId))
+      .toEqual(["ses_descendant", "ses_sibling", "ses_child"])
+    expect(updates.some((update) => update.type === "update" && update.update.sessionUpdate === "agent_message_chunk" && update.childSessionId === "ses_descendant")).toBe(true)
+    expect(updates.some((update) => update.type === "status" && update.status === "failed")).toBe(false)
+    expect(JSON.stringify(updates)).not.toContain("private")
+    expect(rootUpdates).toEqual([])
+  } finally {
+    await fixture.stop()
+  }
+})
+
+test("reports mismatched known parent in its owner projection without another GET", async () => {
+  const childUpdates: ChildSessionUpdate[] = []
+  const rootUpdates: SessionUpdateParams[] = []
+  const fixture = createSseFixture({
+    onPrompt({ id, send }) {
+      send(durableEvent("session.inbox.delivered", { sessionID: "ses_root", inboxID: id }))
+      send(created("ses_child", "ses_root"))
+      send(created("ses_sibling", "ses_root"))
+      dispatch({ send }, "ses_child", "call_wrong_parent", "ses_sibling")
+      dispatch({ send }, "ses_child", "call_self", "ses_child")
+      send(text("ses_sibling", "sibling answer"))
+      send(durableEvent("session.execution.succeeded", { sessionID: "ses_sibling" }))
+      send(durableEvent("session.execution.succeeded", { sessionID: "ses_child" }))
+      send(durableEvent("session.execution.succeeded", { sessionID: "ses_root" }))
+    },
+  })
+  try {
+    expect((await run(fixture, rootUpdates, async (update) => { childUpdates.push(update) })).stopReason).toBe("end_turn")
+    const gaps = childUpdates.flatMap((item) => item.type === "update" && item.update.sessionUpdate === "session_info_update"
+      ? [item.update._meta?.["geocluster/child-observation"]] : [])
+    expect(gaps).toEqual([
+      { state: "incomplete", reason: "registration_failed", toolCallId: "ses_child:call_wrong_parent", childSessionId: "ses_sibling" },
+      { state: "incomplete", reason: "registration_failed", toolCallId: "ses_child:call_self", childSessionId: null },
+    ])
+    expect(fixture.requests.filter((request) => /^\/api\/session\/[^/]+$/.test(request.path))).toEqual([])
+    expect(childUpdates.some((item) => item.type === "status" && item.status === "completed" && item.childSessionId === "ses_sibling")).toBe(true)
+    expect(rootUpdates).toEqual([])
+  } finally {
+    await fixture.stop()
+  }
+})
+
+test.each(["succeeded", "interrupted", "failed"] as const)("registration gap preserves actual foreground outcome: %s", async (outcome) => {
+  const updates: SessionUpdateParams[] = []
+  const fixture = createSseFixture({
+    onSessionGet: () => new Response("private credentials", { status: 500 }),
+    onPrompt({ id, send }) {
+      send(durableEvent("session.inbox.delivered", { sessionID: "ses_root", inboxID: id }))
+      send(created("ses_sibling", "ses_root"))
+      dispatch({ send }, "ses_root", "call_gap", "ses_unknown")
+      send(text("ses_unknown", "private unknown answer"))
+      send(text("ses_sibling", "sibling answer"))
+      send(durableEvent("session.execution.succeeded", { sessionID: "ses_sibling" }))
+      send(text("ses_root", "root answer"))
+      if (outcome === "succeeded") send(durableEvent("session.execution.succeeded", { sessionID: "ses_root" }))
+      if (outcome === "interrupted") send(durableEvent("session.execution.interrupted", { sessionID: "ses_root", reason: "user" }))
+      if (outcome === "failed") send(durableEvent("session.execution.failed", { sessionID: "ses_root", error: { type: "provider.error", message: "Actual provider failure" } }))
+    },
+  })
+  try {
+    const result = run(fixture, updates)
+    if (outcome === "failed") await expect(result).rejects.toMatchObject({ errorName: "provider.error", safeMessage: "Actual provider failure" })
+    if (outcome !== "failed") expect((await result).stopReason).toBe(outcome === "interrupted" ? "cancelled" : "end_turn")
+    expect(updates.filter((item) => item.update.sessionUpdate === "session_info_update")).toEqual([{
+      sessionId: "ses_root", update: { sessionUpdate: "session_info_update", _meta: {
+        "geocluster/child-observation": { state: "incomplete", reason: "registration_failed", toolCallId: "call_gap", childSessionId: "ses_unknown" },
+      } },
+    }])
+    expect(updates.filter((item) => item.update.sessionUpdate === "agent_message_chunk").map((item) => item.update.sessionUpdate === "agent_message_chunk" && item.update.content))
+      .toEqual([{ type: "text", text: "sibling answer" }, { type: "text", text: "root answer" }])
+    expect(JSON.stringify(updates)).not.toContain("private")
+  } finally {
+    await fixture.stop()
+  }
+})
+
+test.each(["connection", "turn"] as const)("intentional %s abort during observation GET emits no invented gap", async (kind) => {
+  const lookup = Promise.withResolvers<void>()
+  const release = Promise.withResolvers<void>()
+  const updates: SessionUpdateParams[] = []
+  const control: TurnControl = { cancelled: false, admission: new AbortController() }
+  const connection = new AbortController()
+  const fixture = createSseFixture({
+    async onSessionGet() {
+      lookup.resolve()
+      await release.promise
+      return new Response("private aborted lookup", { status: 500 })
+    },
+    onPrompt({ id, send }) {
+      send(durableEvent("session.inbox.delivered", { sessionID: "ses_root", inboxID: id }))
+      dispatch({ send }, "ses_root", "call_abort", "ses_unknown")
+    },
+  })
+  const result = run(fixture, updates, undefined, control, connection.signal)
+  try {
+    await withTimeout(lookup.promise, "observation GET did not start")
+    if (kind === "connection") connection.abort()
+    if (kind === "turn") {
+      control.cancelled = true
+      control.admission.abort()
+      fixture.send(durableEvent("session.execution.interrupted", { sessionID: "ses_root", reason: "user" }))
+    }
+    expect((await withTimeout(result, "aborted lookup prevented clean turn closure")).stopReason).toBe("cancelled")
+    expect(updates.some((item) => item.update.sessionUpdate === "session_info_update")).toBe(false)
+  } finally {
+    connection.abort()
+    release.resolve()
+    await result.catch(() => {})
+    await fixture.stop()
+  }
+})
+
+function run(fixture: Fixture, updates: SessionUpdateParams[], childSessionUpdate?: (update: ChildSessionUpdate) => Promise<void>, control: TurnControl = { cancelled: false, admission: new AbortController() }, connectionSignal?: AbortSignal) {
+  return streamTurn({
+    client: fixture.client,
+    connection: {
+      sessionUpdate: async (update) => { updates.push(update) },
+      requestPermission: async () => ({ outcome: { outcome: "cancelled" } }),
+    },
+    sessionID: "ses_root", cwd: "/workspace", start: { type: "input", id: "input_gap" }, writeTextFile: false,
+    control, connectionSignal, childSessionUpdate,
+    submit: (signal) => fixture.client.session.prompt({ sessionID: "ses_root", id: "input_gap", text: "hello" }, { signal }),
+  })
+}
+
+function created(sessionID: string, parentID: string) {
+  return durableEvent("session.created", { sessionID, parentID, slug: sessionID, projectID: "project", location: { directory: "/workspace" }, version: "test" })
+}
+
+function text(sessionID: string, delta: string) {
+  return ephemeralEvent("session.text.delta", { sessionID, assistantMessageID: `msg_${sessionID}`, ordinal: 0, delta })
+}
+
+function dispatch(fixture: Pick<Fixture, "send">, sessionID: string, id: string, childSessionID: string) {
+  fixture.send(durableEvent("session.tool.input.started", { sessionID, assistantMessageID: `msg_${sessionID}`, id, name: "subagent" }))
+  fixture.send(ephemeralEvent("session.tool.progress", { sessionID, assistantMessageID: `msg_${sessionID}`, id, metadata: { sessionID: childSessionID } }))
+}
