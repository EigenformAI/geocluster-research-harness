# =============================================================================
# Docker Ignore File
# Excludes unnecessary files from Docker build context
# =============================================================================

# Git
.git
.gitignore
.gitmodules

# Documentation
*.md
!README.md
docs/

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js
**/node_modules/
**/.npm/
**/.yarn/
**/yarn-error.log
**/npm-debug.log

# Build artifacts
**/dist/
**/build/

# Test files
**/__tests__/
**/*.test.ts
**/*.spec.ts
**/coverage/
**/.gc-file-tests-*/

# Development files
docker-compose*.yml
*.local
.env*
*.log

# Local development workspaces and datasets do not enter the image.
sample-workspace/
local-workspace/
.geocluster-local/
logs/

# The MCP's local virtualenv and caches (the image runs `uv sync` itself)
geocluster-mcp/.venv/
**/__pycache__/
**/.pytest_cache/

# OpenCode: ship the runtime config generator, but not development scripts/tests.
opencode/test/
opencode/prompt-src/
opencode/scripts/*
!opencode/scripts/build-config.mjs
!opencode/config/**/*.md

# Runtime gateway: tests and local deps are not shipped (npm ci runs in the image)
runtime/test/
runtime/node_modules/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# CI/CD
.github/
.gitlab/
.circleci/

# Only the processor-source verifier and pin enter the image build.
scripts/*
!scripts/preprocessing-bundle.py
!scripts/preprocessing-release.json

# Lock files (recreated during build)
# yarn.lock is included for reproducible builds
