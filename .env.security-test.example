# Copy to .env.security-test for local authenticated container testing.
# Export processor build-context settings separately before starting Compose.
# See docs/RUNTIME_FILES_DEPLOYMENT.md.

# Managed backend reachable from the container. Root renews purpose credentials;
# the conversation engine receives only a loopback relay marker.
RUNTIME_PROFILE=managed
LLM_PROXY_URL=http://host.docker.internal:8000/api/v1/llm-proxy
IDE_MACHINE_CREDENTIALS_URL=http://host.docker.internal:8000/api/v1/runtime/credentials/renew
IDE_MACHINE_TOKEN=

# Project gate key matching the backend token issuer and test-project-456.
# Exchange the issued token with POST /auth/exchange before using private routes.
IDE_PROXY_KEY=
RUNTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUNTIME_FRAME_ANCESTORS="'self' http://localhost:3000 http://127.0.0.1:3000"
# RUNTIME_AUTH_DISABLED=1

# Optional private dataset hydration. Credentials are not passed to agents.
IDE_DATASETS_URL=
IDE_DATASET_TOKEN=

# General workspace synchronization is disabled for this fixture.
SYNC_ENABLED=false
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=geocluster-data

# Do not set supplier keys or static purpose tokens in a managed container.
# Managed startup rejects them. Use native/tui for personally funded providers.
